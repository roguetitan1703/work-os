# Nightly on-box copy of the Atlas database (deploy/backup.sh --nightly-local, docs/ops/hosting.md section 11). Not off-box.
[Unit]
Description=Work OS database on-box nightly copy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Its own user, not the app's: the app (any bug in it) cannot read this process's environment (the R2 keys that can
# delete backups, the database URI) through /proc.
User=workos-backup
Group=workos-backup
# Only the backup's own file (database URI, BACKUP_* settings, R2 keys); never /etc/work-os/env. systemd (root) reads
# it, so a missing file fails the unit, on purpose.
EnvironmentFile=/etc/work-os/backup-env
# Root-owned copy of deploy/backup.sh (docs/ops/hosting.md section 4), not the release's.
ExecStart=/usr/local/sbin/work-os-backup --nightly-local
# A shared box with little memory: mongodump streams and is light; the cap stops a surprise, the others keep theirs.
MemoryMax=256M
TasksMax=64
Nice=19
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/backups/work-os
