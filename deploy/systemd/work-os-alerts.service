# The alert check (was cron-job.org against Vercel): POST /api/cron/alerts with the CRON_SECRET header.
# Started by work-os-alerts.timer every 15 minutes. Last runs: journalctl -u work-os-alerts
[Unit]
Description=Work OS alert check
After=work-os.service

[Service]
Type=oneshot
User=workos
Group=workos
EnvironmentFile=/etc/work-os/env
# Root-owned copy of deploy/cron-alerts.sh (docs/hosting.md section 4), not the release's.
ExecStart=/usr/local/sbin/work-os-cron-alerts
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
