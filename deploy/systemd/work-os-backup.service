# Nightly mongodump of the Atlas database to /var/backups/work-os and S3 (deploy/backup.sh, docs/hosting.md "Backups").
[Unit]
Description=Work OS database backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=workos
Group=workos
EnvironmentFile=/etc/work-os/env
# Root-owned copy of deploy/backup.sh (docs/hosting.md section 4), not the release's.
ExecStart=/usr/local/sbin/work-os-backup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/work-os
