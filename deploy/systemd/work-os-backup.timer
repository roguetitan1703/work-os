# 03:00 India time (21:30 UTC), when nobody works. Enable: sudo systemctl enable --now work-os-backup.timer
[Unit]
Description=Work OS nightly backup

[Timer]
OnCalendar=*-*-* 21:30:00 UTC
RandomizedDelaySec=10m
# Server was off at that time: run once it is back.
Persistent=true

[Install]
WantedBy=timers.target
