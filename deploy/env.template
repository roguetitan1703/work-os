# Work OS environment for the EC2 server: copy to /etc/work-os/env (owner root, group workos, mode 0640) and fill in.
# Names only here; the repo is public. docs/hosting.md "Environment" says what each one is for.
# Format: systemd EnvironmentFile, one NAME=value per line, no "export", comments only on their own lines (a # after
# a value would become part of it). Quotes only around a whole value.
# [secret] = never paste into chat, tickets or the repo.

# ── Database (MongoDB Atlas) ──
# [secret] Atlas connection string (user + password of a database user). Atlas only: never the box's own MongoDB
# (docker, 127.0.0.1:27017); work-os-deploy refuses a local address.
MONGODB_URI=
MONGODB_DB=workos

# ── Sign-in ──
# [secret] 64 random hex chars, made once and then kept: changing it signs everyone out and breaks authenticator
# apps. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
APP_URL=https://work.delpat.in
TRUST_PROXY=1
# [secret] Encrypts server actions' bound arguments; Next reads it at runtime and it outlives deploys (the key in a
# published build is public; docs/hosting.md "The build's secrets"). 32 random bytes, base64, made once:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# comma list of the operators' sign-in emails (Om)
OPERATOR_EMAILS=
# unset or 1: inviter sees the link; 0: by email only
INVITE_LINK_TO_INVITER=

# ── Alerts cron (deploy/systemd/work-os-alerts.timer) ──
# [secret] 16+ random characters
CRON_SECRET=

# ── Email (password reset, invitations) ──
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
# [secret]
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=

# ── Phone push ──
VAPID_PUBLIC_KEY=
# [secret]
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Discord bot ──
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# [secret]
DISCORD_BOT_TOKEN=
# optional; normally set in Settings
DISCORD_BLOCKED_CHANNELS=

# ── Delpat OS import (optional: the feature is hidden unless the client id and secret are both set) ──
# Work OS is a registered OAuth client of Delpat OS. The id is public (docs/auth.md "Linking Delpat OS").
DELPAT_OS_CLIENT_ID=cli_4hbK4PhW1d2a7AYMtMXV3Q
# [secret] shown once in the Delpat OS UI; never in chat, tickets or the repo
DELPAT_OS_CLIENT_SECRET=
# optional, default https://os.delpat.in
DELPAT_OS_ISSUER=
# [secret] optional: seals each person's stored Delpat OS tokens. Unset = derived from BETTER_AUTH_SECRET.
# Changing either makes everyone link Delpat OS again.
DELPAT_OS_TOKEN_KEY=

# ── Defaults ──
APP_TZ=Asia/Kolkata
# The app's port on 127.0.0.1 (default 3100). Set it only when something else on the box already listens on 3100
# (deploy/preflight.sh says), and change the port in the Caddy site to the same number. Leave the line commented
# out for 3100: an empty WORK_OS_PORT= would override the unit's default with nothing.
# WORK_OS_PORT=3110

# ── Backups: not here. They have their own file, /etc/work-os/backup-env (deploy/backup-env.template), so the app never holds the storage keys ──

# ── Cut-over only (scripts/cutover.sh); step 6 removes the two DISCORD_ ones ──
# Om's sign-in email
OWNER_EMAIL=
OWNER_NAME=Om
# the Delpat server id, read once by migrate-phase3
DISCORD_GUILD_ID=
# Om's Discord user id, read once by migrate-phase3
DISCORD_OWNER_ID=
