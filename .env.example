# Copy to .env.local for local dev. Set the same keys in Vercel → Settings → Environment Variables.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=workos

# Sign-in (Better Auth, docs/auth.md). 64 random hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs session cookies and MCP confirm tokens, encrypts authenticator-app secrets (rotating it signs everyone out
# and breaks existing authenticator apps). SESSION_SECRET is still read if this is unset.
BETTER_AUTH_SECRET=
# Optional: AUTH_RATE_LIMIT=off turns off Better Auth's sign-in rate limits (tests only).
AUTH_RATE_LIMIT=
# Set to 1 when Vercel or our own reverse proxy sets X-Real-IP / X-Forwarded-For (per-IP sign-in limits trust them
# only then; without it all clients share one bucket). nginx: proxy_set_header X-Real-IP $remote_addr;
TRUST_PROXY=

# Timezone used for "today", due dates and the morning brief
APP_TZ=Asia/Kolkata
NEXT_PUBLIC_APP_TZ=Asia/Kolkata

# The site's public address, e.g. https://work.delpat.in. Required in production: Better Auth's base URL, the passkey
# domain (passkeys only work on the domain they were made on), links in emails and to Claude. Local dev: http://localhost:3000.
APP_URL=

# Only if your MCP client cannot send headers: allow /api/mcp/<key> URLs (Claude chat keys only)
MCP_ALLOW_URL_TOKEN=

# Discord (see /connect): Developer Portal → General Information / Bot; IDs via Developer Mode → Copy ID
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

# Alerts: secret for /api/cron/alerts (called every 15 min by cron-job.org)
CRON_SECRET=

# Phone push notifications (Web Push). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email (SMTP) for "Forgot password?" links, password-change notices and the Settings test email.
# EMAIL_SECURE=true for TLS from the start (usually port 465); otherwise STARTTLS is required (e.g. 587).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=
# Only for scripts/migrate-auth.mjs: the first user's address (the owner of Delpat).
OWNER_EMAIL=
# Tests only: write mail as JSON files in this folder instead of sending it.
MAIL_CAPTURE_DIR=
