# Copy to .env.local for local dev. Set the same keys in Vercel → Settings → Environment Variables.

# MongoDB Atlas connection string (Database → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=workos

# Web UI login. Leave APP_PASSWORD unset locally to skip login in `npm run dev`.
APP_PASSWORD=
# 64 random hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret for the MCP endpoint and JSON API (min 24 chars, same command as above)
MCP_TOKEN=

# Timezone used for "today", due dates and the morning brief
APP_TZ=Asia/Kolkata
NEXT_PUBLIC_APP_TZ=Asia/Kolkata

# Optional: public base URL used in task links returned to Claude (defaults to the request origin)
APP_URL=

# Only if your MCP client cannot send headers: allow /api/mcp/<MCP_TOKEN> URLs
MCP_ALLOW_URL_TOKEN=

# Discord (see /connect): Developer Portal → General Information / Bot; IDs via Developer Mode → Copy ID
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
