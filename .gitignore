# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (never commit)
/data/*.json
/data/*.bak

# Local-only folders at the project root (never committed: test data, backups, editor settings)
/.scratch-mongo/
/backups/
/.vscode/
/.claude/settings.local.json
/work-os/
/DESIGN_CONTEXT.md
/work_modes_os_spec.md
